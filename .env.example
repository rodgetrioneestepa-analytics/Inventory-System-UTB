PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/utb.sqlite
# Optional server-only PostgreSQL URL. Omit it to use local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Production: serve behind HTTPS, set NODE_ENV=production, APP_ORIGIN to its exact URL.
# One-time CLI only; prefer the interactive password prompt. Never commit credentials.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Vercel frontend build only: public HTTPS backend origin, without /api.
# UTB_API_ORIGIN=
