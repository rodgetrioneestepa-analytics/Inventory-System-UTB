{
  "name": "under-the-balete-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format": "prettier --write frontend backend api shared tests config scripts/*.mjs scripts/*.ts",
    "format:check": "prettier --check frontend backend api shared tests config scripts/*.mjs scripts/*.ts",
    "dev": "concurrently -k \"tsx watch backend/src/index.ts\" \"vite --config config/vite.config.ts --host 127.0.0.1\"",
    "build": "tsc -p config/tsconfig.backend.json && tsc -p config/tsconfig.frontend.json && vite build --config config/vite.config.ts",
    "build:backend": "tsc -p config/tsconfig.backend.json",
    "build:vercel": "tsc -p config/tsconfig.frontend.json && vite build --config config/vite.config.ts && node scripts/build-vercel.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "tunnel": "node scripts/local-tunnel.mjs",
    "test": "tsx --test tests/backend/*.test.ts",
    "test:postgres": "tsx --test tests/postgres.test.ts",
    "test:cloud": "tsx --test tests/cloud-storage.test.ts",
    "test:browser": "playwright test --config config/playwright.config.ts",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "migrate": "tsx backend/src/migrate.ts",
    "migrate:cloud": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "admin:create": "tsx backend/src/admin.ts",
    "catalog:import": "tsx backend/src/catalog.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
